{
  "name": "cysoeditor-desktop",
  "description": "CYSOEditor - Visual programming editor with Aurora theme, CYSO Core, and high-performance compiler engine.",
  "version": "1.0.0",
  "license": "GPL-3.0",
  "author": {
    "email": "cy_studio_001@163.com",
    "name": "CY Studio"
  },
  "type": "commonjs",
  "scripts": {
    "fetch": "node scripts/download-library-files.mjs && node scripts/download-packager.mjs && node scripts/prepare-extensions.mjs",
    "webpack:compile": "cross-env NODE_ENV=production webpack --config webpack.config.cjs",
    "webpack:watch": "webpack --config webpack.config.cjs --watch",
    "webpack:prod": "cross-env NODE_ENV=production webpack --config webpack.config.cjs",
    "electron:start": "electron src-main/entrypoint.js",
    "electron:package:dir": "electron-builder --dir"
  },
  "dependencies": {
    "graceful-fs": "^4.2.11",
    "prop-types": "^15.8.1",
    "react": "^16.0.0",
    "react-dom": "^16.0.0",
    "react-redux": "^5.0.7",
    "redux": "^3.7.2",
    "scratch-blocks": "^1.3.0",
    "semver": "^7.7.3",
    "scratch-paint": "../scratch-paint",
    "cyso-core": "../CYSO-Core",
    "@turbowarp/json": "0.1.2",
    "@turbowarp/jszip": "3.12.0",
    "@turbowarp/nanolog": "1.0.1",
    "@turbowarp/scratch-l10n": "3.1001.202405101234",
    "@turbowarp/scratch-storage": "0.0.202505311821",
    "@turbowarp/scratch-svg-renderer": "1.1.0",
    "@turbowarp/startaudiocontext": "1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.12.16",
    "@babel/preset-react": "^7.13.13",
    "@electron/fuses": "^2.0.0",
    "@turbowarp/extensions": "../extensions",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^9.8.8",
    "babel-loader": "^8.4.1",
    "copy-webpack-plugin": "^6.4.1",
    "cross-env": "^10.1.0",
    "css-loader": "^1.0.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.3.5",
    "file-loader": "^6.2.0",
    "postcss": "^8.4.13",
    "postcss-import": "^14.0.0",
    "postcss-loader": "^4.2.0",
    "postcss-simple-vars": "^6.0.3",
    "scratch-gui": "../scratch-gui",
    "style-loader": "^0.23.0",
    "url-loader": "^4.1.1",
    "webpack": "4.47.0",
    "webpack-cli": "^3.3.12"
  },
  "overrides": {
    "webpack@4.47.0": {
      "terser-webpack-plugin": "^4.2.3"
    }
  },
  "homepage": "https://cysoeditor.pages.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/CYSO-Editor/desktop.git"
  },
  "bugs": {
    "url": "https://github.com/CYSO-Editor/desktop/issues",
    "email": "cy_studio_001@163.com"
  },
  "main": "./src-main/entrypoint.js",
  "build": {
    "appId": "org.cysoeditor.desktop",
    "productName": "CYSOEditor",
    "copyright": "Copyright © 2024-2026 CY Studio. Licensed under GPL-3.0",
    "forceCodeSigning": false,
    "files": [
      "node_modules/**/*",
      "src-main/**/*",
      "src-preload/**/*",
      "src-renderer/**/*",
      "src-renderer/packager/standalone.html",
      "src-renderer/packager/scaffolding/scaffolding-min.js",
      "src-renderer/packager/scaffolding/scaffolding-full.js",
      "dist-renderer-webpack/**/*",
      "dist-library-files/**/*",
      "dist-extensions/**/*"
    ],
    "extraResources": [
      {
        "from": "art/icon.png",
        "to": "icon.png"
      },
      {
        "from": "art/icon.svg",
        "to": "icon.svg"
      }
    ],
    "win": {
      "artifactName": "${productName} Portable ${version} ${arch}.${ext}",
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "portable",
          "arch": "x64"
        }
      ]
    },
    "appx": {
      "artifactName": "${productName}-MS-Store-${version}-${arch}.${ext}",
      "applicationId": "CYSOEditor",
      "displayName": "CYSOEditor",
      "identityName": "45747CYStudio.CYSOEditorDesktop",
      "publisher": "CN=18FA7D4F-01BF-49F2-BF56-782DCEA49C69",
      "publisherDisplayName": "CY Studio",
      "backgroundColor": "#32c8dc",
      "showNameOnTiles": true,
      "languages": [
        "zh-CN",
        "en-US",
        "ja",
        "ko"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CYSOEditor",
      "uninstallDisplayName": "CYSOEditor",
      "license": "build/license.txt"
    },
    "mac": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "darkModeSupport": true,
      "gatekeeperAssess": false,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSMultipleInstancesProhibited": true,
        "NSCameraUsageDescription": "CYSOEditor 需要摄像头权限以支持视频侦测和面部识别积木。",
        "NSMicrophoneUsageDescription": "CYSOEditor 需要麦克风权限以录制声音或检测响度。"
      },
      "target": [
        {
          "arch": "universal",
          "target": "dmg"
        }
      ]
    },
    "mas": {
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/distribution.provisionprofile"
    },
    "masDev": {
      "type": "development",
      "provisioningProfile": "build/development.provisionprofile"
    },
    "linux": {
      "executableName": "cysoeditor",
      "artifactName": "${productName}-${os}-${arch}-${version}.${ext}",
      "icon": "./build/",
      "synopsis": "Visual programming editor powered by CYSO Core",
      "description": "CYSOEditor is a visual programming editor based on Scratch, featuring Aurora theme, CYSO Core permission system, high-performance compiler engine, extension ecosystem, and one-click project packaging.",
      "category": "Development",
      "desktop": {
        "entry": {
          "StartupWMClass": "cysoeditor",
          "Keywords": "scratch;visual;programming;education;"
        }
      },
      "extraFiles": [
        "linux-files"
      ],
      "target": [
        {
          "target": "deb"
        },
        {
          "target": "appimage"
        },
        {
          "target": "tar.gz"
        }
      ]
    },
    "snap": {
      "summary": "CYSOEditor - Visual programming editor with Aurora theme & CYSO Core",
      "allowNativeWayland": true,
      "plugs": [
        "default",
        "camera",
        "audio-record",
        "joystick",
        "removable-media"
      ]
    },
    "appImage": {
      "license": null
    },
    "fileAssociations": [
      {
        "ext": "sb3",
        "name": "CYSOEditor Project",
        "description": "CYSOEditor Scratch 3 Project",
        "role": "Editor",
        "mimeType": "application/x.scratch.sb3"
      },
      {
        "ext": "sb2",
        "name": "CYSOEditor Project (Scratch 2)",
        "description": "CYSOEditor Scratch 2 Project",
        "role": "Editor",
        "mimeType": "application/x.scratch.sb2"
      },
      {
        "ext": "sb",
        "name": "CYSOEditor Project (Scratch 1)",
        "description": "CYSOEditor Scratch 1 Project",
        "role": "Editor",
        "mimeType": "application/x.scratch.sb"
      }
    ]
  },
  "private": true
}
